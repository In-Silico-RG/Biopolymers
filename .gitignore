# Raw exports are large and re-harvestable from queries/; kept local only
data/raw/
*.aux
*.log
*.out
*.toc
.Rhistory
.RData
__pycache__/
*.pyc
.venv/
.venv/

# Recovered abstracts are large and rebuildable from the scripts
data/processed/crossref_abstracts.jsonl
data/processed/recovered_abstracts.jsonl

# API tokens must never be committed
.lens_token
.openalex_key
*.token

# Full texts are not committed
refs/pdfs/*.pdf
