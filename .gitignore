# Raw exports can be large; keep them local unless small enough to version
data/raw/**/*.zip
data/raw/**/*.xlsx
*.aux
*.log
*.out
*.toc
.Rhistory
.RData
__pycache__/
*.pyc
.venv/
.venv/

# Recovered abstracts are large and rebuildable from the scripts
data/processed/crossref_abstracts.jsonl
data/processed/recovered_abstracts.jsonl

# API tokens must never be committed
.lens_token
.openalex_key
*.token

# Lens raw records are large and re-harvestable from the manifest
data/raw/lens/*.jsonl
